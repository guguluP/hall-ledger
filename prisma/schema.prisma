generator client {
  provider      = "prisma-client-js"
  // Netlify functions run on Amazon Linux (OpenSSL 3); builds run on Ubuntu.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// PostgreSQL (Supabase). DATABASE_URL is the pooled connection (port 6543,
// ?pgbouncer=true) used at runtime; DIRECT_URL is the direct connection
// (port 5432) used by `prisma migrate`. Role, TokenType, and VersionStatus stay
// strings; allowed values live in src/lib/auth/roles.ts. The Slot time CHECK and
// RLS are part of the migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String?
  passwordHash    String
  emailVerifiedAt DateTime?
  failedLogins    Int          @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime     @default(now())
  sessions        Session[]
  memberships     Membership[]
  tokens          AuthToken[]
}

model Session {
  id         String   @id
  userId     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now())

  @@index([key, at])
}

model Institution {
  id            String            @id @default(cuid())
  slug          String            @unique
  name          String
  isPublic      Boolean           @default(true)
  dayStartMin   Int               @default(570)
  dayEndMin     Int               @default(1050)
  sundayOpen    Boolean           @default(false)
  createdAt     DateTime          @default(now())
  memberships   Membership[]
  invites       Invite[]
  rooms         Room[]
  timetables    Timetable[]
  strengths     SectionStrength[]
  aliases       SlugAlias[]
  retiredRooms  RetiredRoom[]
  closures      Closure[]
  changes       ScheduleChange[]
  reports       CrowdReport[]
  bookings      BookingRequest[]
  observations  OccupancyNote[]
  alertPrefs    AlertPreference[]
}

model Membership {
  institutionId String
  userId        String
  role          String      @default("EDITOR")
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([institutionId, userId])
}

model Invite {
  id            String      @id @default(cuid())
  institutionId String
  email         String
  role          String
  tokenHash     String      @unique
  invitedById   String
  expiresAt     DateTime
  acceptedAt    DateTime?
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, email])
}

model Room {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  building      String?
  capacity      Int         @default(60)
  isLab         Boolean     @default(false)
  floor         Int?
  hasProjector  Boolean     @default(false)
  hasSmartBoard Boolean     @default(false)
  hasAc         Boolean     @default(false)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, name])
}

model Timetable {
  id              String             @id @default(cuid())
  institutionId   String
  name            String
  activeVersionId String?            @unique
  institution     Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  versions        TimetableVersion[] @relation("versions")

  @@unique([institutionId, name])
}

model TimetableVersion {
  id            String    @id @default(cuid())
  timetableId   String
  status        String    @default("DRAFT")
  fileName      String?
  fileSha256    String?
  createdById   String
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  conflictCount Int       @default(0)
  warnings      Json?
  timetable     Timetable @relation("versions", fields: [timetableId], references: [id], onDelete: Cascade)
  slots         Slot[]

  @@index([timetableId, status])
}

model Slot {
  id        String           @id @default(cuid())
  versionId String
  roomId    String?
  roomName  String?
  section   String
  subject   String?
  type      String
  teacher   String?
  dayOfWeek Int
  startMin  Int
  endMin    Int
  version   TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, dayOfWeek])
}

model SectionStrength {
  id            String      @id @default(cuid())
  institutionId String
  section       String
  students      Int
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, section])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  institutionId String?
  action        String
  details       String?
  createdAt     DateTime @default(now())

  @@index([action, createdAt])
}

model SlugAlias {
  slug          String      @id
  institutionId String
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model RetiredRoom {
  id            String      @id @default(cuid())
  institutionId String
  roomKey       String
  name          String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, roomKey])
}

model Closure {
  id            String      @id @default(cuid())
  institutionId String
  startDate     String
  endDate       String
  kind          String
  label         String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, startDate])
}

model ScheduleChange {
  id            String      @id @default(cuid())
  institutionId String
  date          String
  kind          String
  section       String?
  subject       String?
  teacher       String?
  roomName      String?
  fromRoom      String?
  startMin      Int
  endMin        Int
  note          String?
  createdById   String
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, date])
}

model CrowdReport {
  id            String      @id @default(cuid())
  institutionId String
  roomKey       String
  roomName      String
  kind          String
  createdAt     DateTime    @default(now())
  expiresAt     DateTime
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, expiresAt])
}

model BookingRequest {
  id            String      @id @default(cuid())
  institutionId String
  roomName      String
  date          String
  startMin      Int
  endMin        Int
  purpose       String
  requesterId   String
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, status])
}

model OccupancyNote {
  id            String      @id @default(cuid())
  institutionId String
  roomName      String
  occupied      Boolean
  headcount     Int?
  observedAt    DateTime    @default(now())
  source        String
  createdById   String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, observedAt])
}

model AlertPreference {
  institutionId String
  userId        String
  email         Boolean     @default(true)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([institutionId, userId])
}
