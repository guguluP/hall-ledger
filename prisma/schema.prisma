generator client {
  provider = "prisma-client-js"
}

// SQLite keeps local dev and CI runnable without a database server.
// Production Postgres: change provider to "postgresql", point DATABASE_URL
// at the server, run `prisma migrate`, then apply prisma/postgres/slot-check.sql.
// Role, TokenType, and VersionStatus are strings here because Prisma enums
// are not available on SQLite. Allowed values live in src/lib/auth/roles.ts.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String?
  passwordHash    String
  emailVerifiedAt DateTime?
  failedLogins    Int          @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime     @default(now())
  sessions        Session[]
  memberships     Membership[]
  tokens          AuthToken[]
}

model Session {
  id         String   @id
  userId     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now())

  @@index([key, at])
}

model Institution {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  isPublic    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  memberships Membership[]
  invites     Invite[]
  rooms       Room[]
  timetables  Timetable[]
  strengths   SectionStrength[]
}

model Membership {
  institutionId String
  userId        String
  role          String      @default("EDITOR")
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([institutionId, userId])
}

model Invite {
  id            String      @id @default(cuid())
  institutionId String
  email         String
  role          String
  tokenHash     String      @unique
  invitedById   String
  expiresAt     DateTime
  acceptedAt    DateTime?
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, email])
}

model Room {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  building      String?
  capacity      Int         @default(60)
  isLab         Boolean     @default(false)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, name])
}

model Timetable {
  id              String             @id @default(cuid())
  institutionId   String
  name            String
  activeVersionId String?            @unique
  institution     Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  versions        TimetableVersion[] @relation("versions")

  @@unique([institutionId, name])
}

model TimetableVersion {
  id            String    @id @default(cuid())
  timetableId   String
  status        String    @default("DRAFT")
  fileName      String?
  fileSha256    String?
  createdById   String
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  conflictCount Int       @default(0)
  warnings      Json?
  timetable     Timetable @relation("versions", fields: [timetableId], references: [id], onDelete: Cascade)
  slots         Slot[]

  @@index([timetableId, status])
}

model Slot {
  id        String           @id @default(cuid())
  versionId String
  roomId    String?
  roomName  String?
  section   String
  subject   String?
  type      String
  dayOfWeek Int
  startMin  Int
  endMin    Int
  version   TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, dayOfWeek])
}

model SectionStrength {
  id            String      @id @default(cuid())
  institutionId String
  section       String
  students      Int
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, section])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  institutionId String?
  action        String
  details       String?
  createdAt     DateTime @default(now())

  @@index([action, createdAt])
}
