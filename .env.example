# PostgreSQL. In production (Supabase) use the pooled connection on port 6543 with
# ?pgbouncer=true&connection_limit=1 for DATABASE_URL, and the direct connection on
# port 5432 for DIRECT_URL (used by prisma migrate). Locally both can point at the same DB.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hall"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hall"
# Throwaway databases for `npm test` and `npm run test:e2e`. They are wiped on every run.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hall_test"
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hall_e2e_test"

# Public origin used for email links. Never use the request Host header.
APP_URL="http://localhost:3000"

# Optional pepper mixed into session and token hashes. Changing it signs everyone out.
SESSION_SECRET=""

# Rate limits ignore X-Forwarded-For unless this is 1. Then the last hop is used.
# Netlify's x-nf-client-connection-ip is always preferred when present.
TRUST_PROXY="0"
# Optional extra header, for example x-real-ip, read only when set.
TRUSTED_IP_HEADER=""

# SMTP. When these are empty in development, links are printed and appended to .mail-dev.log
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Hall Ledger <noreply@localhost>"

# Optional demo owner created by prisma/seed.ts
SEED_OWNER_EMAIL="owner@demo.hallledger.test"
SEED_OWNER_PASSWORD="DemoOwner-2026"
