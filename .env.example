# SQLite for local dev / Prisma generate (file path relative to prisma/)
# Not required at runtime for Grid / Find / Upload (seed + client cache).
DATABASE_URL="file:./dev.db"

# Auth (optional — only if you wire next-auth later)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional: protect POST /api/timetable/publish on shared hosts (Netlify/Vercel).
# Send header: x-publish-secret: <same value>  (or Authorization: Bearer <same>)
# Leave unset to keep publish open (current default).
# PUBLISH_SECRET=

# On Netlify, also set NEXTAUTH_URL to the production site URL if using auth.
