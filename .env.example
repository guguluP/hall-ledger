# SQLite for local dev (path is relative to prisma/)
DATABASE_URL="file:./dev.db"

# Public origin used for email links. Never use the request Host header.
APP_URL="http://localhost:3000"

# Optional pepper mixed into session and token hashes. Changing it signs everyone out.
SESSION_SECRET=""

# Rate limits ignore X-Forwarded-For unless this is 1. Then the last hop is used.
# Netlify's x-nf-client-connection-ip is always preferred when present.
TRUST_PROXY="0"
# Optional extra header, for example x-real-ip, read only when set.
TRUSTED_IP_HEADER=""

# SMTP. When these are empty in development, links are printed and appended to .mail-dev.log
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Hall Ledger <noreply@localhost>"

# Optional demo owner created by prisma/seed.ts
SEED_OWNER_EMAIL="owner@demo.hallledger.test"
SEED_OWNER_PASSWORD="DemoOwner-2026"
