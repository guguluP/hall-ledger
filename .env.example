# --- Build-time only -------------------------------------------------------
# Prisma reads this to generate its client. Grid / Find / Upload do not use a
# database at runtime (bundled seed + latest publish + browser cache).
DATABASE_URL="file:./dev.db"

# --- Publishing -------------------------------------------------------------
# REQUIRED in production. POST /api/timetable/publish returns 503 when this is
# unset and NODE_ENV=production, and 401 when the caller sends the wrong value.
# Send as header `x-publish-secret: <value>` or `Authorization: Bearer <value>`.
# On the Upload page, type the same value into "Publish key".
# Locally (NODE_ENV=development) publish works without it.
# Generate one with: openssl rand -base64 32
# PUBLISH_SECRET=

# --- Optional limits --------------------------------------------------------
# Max size of an uploaded timetable file, in bytes (default 5242880 = 5 MB).
# UPLOAD_MAX_BYTES=5242880
# Max size of a publish request body, in bytes (default 10485760 = 10 MB).
# PUBLISH_MAX_BYTES=10485760
